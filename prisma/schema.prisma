datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  HOST
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(HOST)
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  eventTypes     EventType[]
  availabilities Availability[]
  hostedBookings Booking[]       @relation("HostBookings")
  auditLogs      AuditLog[]      @relation("UserAuditLogs")

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EventType {
  id              String   @id @default(cuid())
  slug            String
  title           String
  description     String?  @db.Text
  durationMinutes Int      @default(30)
  bufferBeforeMin Int      @default(0)
  bufferAfterMin  Int      @default(10)
  isActive        Boolean  @default(true)
  hostId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([hostId, slug])
  @@index([hostId, isActive])
}

model Availability {
  id           String   @id @default(cuid())
  userId       String
  dayOfWeek    Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String   // Format "HH:mm" e.g. "09:00"
  endTime      String   // Format "HH:mm" e.g. "17:00"
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id             String        @id @default(cuid())
  uid            String        @unique @default(cuid())
  eventTypeId    String
  hostId         String
  attendeeName   String
  attendeeEmail  String
  attendeeNotes  String?       @db.Text
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(CONFIRMED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  host      User      @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, startTime, endTime])
  @@index([attendeeEmail])
  @@index([status])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  action         String
  targetResource String
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, timestamp])
  @@index([action])
}

model DemoRequest {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  organization String
  useCase      String
  hours        String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

# ==============================================================================
# MHAF Live — Environment Configuration Template
# All values below are placeholders for local development and architecture reference.
# Copy this file to .env.local for local overrides. Do NOT commit secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Authentication (NextAuth / JWT) [Phase 2 prerequisite]
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="placeholder_nextauth_secret_minimum_32_characters_long"
NEXTAUTH_URL="http://localhost:3000"

# Production Host Bootstrap (Optional - leave empty to register initial host via /register)
# In production, default development seed (host@mhaf.live / Password123!) is strictly disabled.
SEED_DEMO_HOST="false"
INITIAL_HOST_EMAIL=""
INITIAL_HOST_PASSWORD=""
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL via Prisma ORM) [Phase 2 prerequisite]
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mhaf_live?schema=public"

# ------------------------------------------------------------------------------
# 4. LiveKit Real-Time Media Engine [Phase 3 prerequisite]
# Obtain credentials from LiveKit Cloud dashboard or self-hosted livekit-server
# ------------------------------------------------------------------------------
LIVEKIT_URL="wss://mhaf-465ece3x.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://mhaf-465ece3x.livekit.cloud"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# Set to "false" to bypass the 15-minute early window and allow entering rooms anytime
ENFORCE_MEETING_TIME_WINDOW="true"


# ------------------------------------------------------------------------------
# 5. Cloud Object Storage / Egress Archival (S3 Compatible) [Phase 5 prerequisite]
# Compatible with AWS S3, Cloudflare R2, or local MinIO instance
# ------------------------------------------------------------------------------
S3_BUCKET_NAME="mhaf-live-recordings"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="placeholder_s3_key"
S3_SECRET_ACCESS_KEY="placeholder_s3_secret"
S3_ENDPOINT="" # Leave empty for AWS S3, or specify http://localhost:9000 for MinIO
S3_FORCE_PATH_STYLE="false"

# ------------------------------------------------------------------------------
# 6. Transactional Email & Notifications (Resend / SMTP) [Phase 2 prerequisite]
# ------------------------------------------------------------------------------
EMAIL_FROM="MHAF Live <notifications@mhaf.live>"
RESEND_API_KEY="re_placeholder_api_key"

# ------------------------------------------------------------------------------
# 7. AI Speech-to-Text & Transcription [Phase 5 prerequisite]
# Providers: "deepgram" | "openai" | "whisper-local"
# ------------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER="deepgram"
DEEPGRAM_API_KEY="placeholder_deepgram_key"
OPENAI_API_KEY="placeholder_openai_key"
